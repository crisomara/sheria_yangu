# Sheria Yangu — environment variables
# Copy this file to .env and fill in the key(s) you need.

# Demo mode (default, USE_GOOGLE_API = False in config.py):
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Production mode (USE_GOOGLE_API = True in config.py, unlocks Antigravity):
# Requires a Google Cloud project with billing enabled.
GOOGLE_API_KEY=
