# Sheria Yangu — environment variables
# Copy this file to .env and fill in the key(s) you need.

# Default provider (USE_GOOGLE_API = True in config.py):
# A free Google AI Studio key works for the standard tier.
# Get one at https://aistudio.google.com/apikey
# The reasoning tier (gemini-3.1-pro-preview) needs a billed Google Cloud
# project; without one it falls back to the standard model automatically.
GOOGLE_API_KEY=

# Alternate providers (set USE_GOOGLE_API = False in config.py to use these):
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# API security settings — all optional, sensible defaults apply if unset.
# Comma-separated browser origins allowed by CORS. Empty = deny all
# cross-origin browser requests (does not affect curl/notebook/requests calls).
# Example: ALLOWED_ORIGINS=https://sheria-yangu.example.com,http://localhost:3000
ALLOWED_ORIGINS=

# Requests per minute, per client IP, on /analyse/text and /analyse/file.
# RATE_LIMIT_PER_MINUTE=10

# Reject request text longer than this many characters.
# MAX_TEXT_LENGTH=20000

# Reject file uploads larger than this many bytes (default 10 MB).
# MAX_UPLOAD_BYTES=10485760
