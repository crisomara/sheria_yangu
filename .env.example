# Sheria Yangu — environment variables
# Copy this file to .env and fill in the key(s) you need.

# Default provider (USE_GOOGLE_API = True in config.py):
# A free Google AI Studio key works for the standard tier.
# Get one at https://aistudio.google.com/apikey
# The reasoning tier (gemini-3.1-pro-preview) needs a billed Google Cloud
# project; without one it falls back to the standard model automatically.
GOOGLE_API_KEY=

# Alternate providers (set USE_GOOGLE_API = False in config.py to use these):
OPENAI_API_KEY=
OPENROUTER_API_KEY=
